# FRIDAY configuration. Copy to .env and edit. .env is git-ignored.
# Every variable below except GEMINI_API_KEY has a working default.
# Full reference: docs/CONFIGURATION.md

# ---- required -------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- identity -------------------------------------------------------------
FRIDAY_NAME=Friday
FRIDAY_OWNER=Srihari
# FRIDAY_DATA_DIR=~/.friday
FRIDAY_LOG_LEVEL=INFO

# Arms run_shell_command. Read the warning in docs/CONFIGURATION.md first.
FRIDAY_ALLOW_SHELL=false

# ---- language model -------------------------------------------------------
FRIDAY_MODEL=gemini-2.5-flash
FRIDAY_TEMPERATURE=0.7
FRIDAY_THINKING_BUDGET=0
FRIDAY_MAX_OUTPUT_TOKENS=512
FRIDAY_STREAM=true

# ---- audio capture --------------------------------------------------------
FRIDAY_SAMPLE_RATE=16000
FRIDAY_FRAME_MS=30
FRIDAY_SILENCE_TAIL_MS=900
FRIDAY_MAX_UTTERANCE_S=20
FRIDAY_VAD_AGGRESSIVENESS=2
FRIDAY_PREROLL_MS=300
# FRIDAY_INPUT_DEVICE=

# ---- languages ------------------------------------------------------------
# Fallback language when detection is unsure.
FRIDAY_LANGUAGE=en
# Languages she may switch into. Listing only the ones you actually speak
# makes detection noticeably more accurate.
# Available: en ml hi ta es it fr de zh ko ja
FRIDAY_LANGUAGES=en,ml,hi,ta,es,it,fr,de,zh,ko,ja
# Follow whichever language you speak. Set false to stay in FRIDAY_LANGUAGE.
FRIDAY_AUTO_DETECT_LANGUAGE=true

# ---- speech to text -------------------------------------------------------
# Leave unset to let FRIDAY choose: base.en for English only, small when
# multiple languages are enabled (.en models cannot transcribe other languages).
# Use medium for better Malayalam, Tamil or Hindi accuracy, at a latency cost.
# FRIDAY_WHISPER_MODEL=small
FRIDAY_WHISPER_DEVICE=cpu
FRIDAY_WHISPER_COMPUTE_TYPE=int8
FRIDAY_WHISPER_BEAM_SIZE=1
FRIDAY_WHISPER_VAD_FILTER=true

# ---- text to speech -------------------------------------------------------
# auto | piper | pyttsx3 | none
FRIDAY_TTS_ENGINE=auto
FRIDAY_PIPER_MODEL=voices/en_US-amy-medium.onnx
FRIDAY_PIPER_SAMPLE_RATE=22050
FRIDAY_TTS_RATE=185
FRIDAY_VOICE_DIR=voices
# FRIDAY_TTS_VOICE=

# Per-language voice overrides. See docs/LANGUAGES.md.
# FRIDAY_PIPER_VOICE_ES=voices/es_ES-davefx-medium.onnx
# FRIDAY_PIPER_VOICE_HI=voices/hi_IN-custom-medium.onnx
# FRIDAY_TTS_VOICE_JA=

# ---- wake word ------------------------------------------------------------
# Pre-trained: hey_jarvis, alexa, hey_mycroft. Or an absolute .onnx path.
FRIDAY_WAKE_MODELS=hey_jarvis
FRIDAY_WAKE_THRESHOLD=0.5
FRIDAY_WAKE_COOLDOWN_S=1.5
FRIDAY_WAKE_ACKNOWLEDGE=true
